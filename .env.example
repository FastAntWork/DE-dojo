# Скопируй в .env и правь под себя:  cp .env.example .env
# .env в git не попадает (см. .gitignore).

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=dojo
POSTGRES_PASSWORD=dojo_local_dev
POSTGRES_DB=dojo
# Порт публикуется только на loopback — снаружи машины БД недоступна.
POSTGRES_HOST_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST_PORT=6379

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST_PORT=8000
DOJO_ENV=local
DOJO_LOG_LEVEL=INFO

# ── Лимиты памяти контейнеров ────────────────────────────────────────────────
# Хост 16 ГБ, WSL2 отдано 11 ГБ (.wslconfig). Весь стек одновременно не влезает
# и не должен — см. docs/adr/0004 и профили в README.
MEM_POSTGRES=1g
MEM_REDIS=384m
MEM_API=768m
