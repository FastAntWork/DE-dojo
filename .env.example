# Скопируй в .env и правь под себя:  cp .env.example .env
# .env в git не попадает (см. .gitignore).

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=dojo
POSTGRES_PASSWORD=dojo_local_dev
POSTGRES_DB=dojo
# Порт публикуется только на loopback — снаружи машины БД недоступна.
POSTGRES_HOST_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST_PORT=6379

# ── Подключения приложения ───────────────────────────────────────────────────
# DSN задаётся целиком, а не собирается из частей: изнутри контейнера хост
# `postgres`, снаружи `127.0.0.1`, и склейка по кускам каждый раз рождает
# вопрос «а какой порт тут имеется в виду». Значения ниже — для запуска
# с хоста; контейнерам compose передаёт свои.
DATABASE_URL=postgresql://dojo:dojo_local_dev@127.0.0.1:5432/dojo
REDIS_URL=redis://127.0.0.1:6379/0

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST_PORT=8000
DOJO_ENV=local
DOJO_LOG_LEVEL=INFO

# ── Лимиты памяти контейнеров ────────────────────────────────────────────────
# Хост 16 ГБ, WSL2 отдано 11 ГБ (.wslconfig). Весь стек одновременно не влезает
# и не должен — см. docs/adr/0004 и профили в README.
MEM_POSTGRES=1g
MEM_REDIS=384m
MEM_API=768m
