# Скопируй в .env и правь под себя:  cp .env.example .env
# .env в git не попадает (см. .gitignore).

# ── Postgres ─────────────────────────────────────────────────────────────────
POSTGRES_USER=dojo
POSTGRES_PASSWORD=dojo_local_dev
POSTGRES_DB=dojo
# Порт публикуется только на loopback — снаружи машины БД недоступна.
POSTGRES_HOST_PORT=5432

# ── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST_PORT=6379

# ── Подключения приложения ───────────────────────────────────────────────────
# DSN задаётся целиком, а не собирается из частей: изнутри контейнера хост
# `postgres`, снаружи `127.0.0.1`, и склейка по кускам каждый раз рождает
# вопрос «а какой порт тут имеется в виду». Значения ниже — для запуска
# с хоста; контейнерам compose передаёт свои.
DATABASE_URL=postgresql://dojo:dojo_local_dev@127.0.0.1:5432/dojo
REDIS_URL=redis://127.0.0.1:6379/0

# ── API ──────────────────────────────────────────────────────────────────────
API_HOST_PORT=8000
DOJO_ENV=local
DOJO_LOG_LEVEL=INFO

# ── Профиль ai ───────────────────────────────────────────────────────────────
OLLAMA_HOST_PORT=11434

# ── Профиль analytics ────────────────────────────────────────────────────────
KAFKA_HOST_PORT=9092
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=dojo
CLICKHOUSE_PASSWORD=dojo_local_dev
PROMETHEUS_HOST_PORT=9090
GRAFANA_HOST_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=dojo_local_dev
# Плагин ClickHouse качается из интернета при первом старте Grafana.
# Оставь пустым, чтобы analytics поднимался полностью офлайн.
GRAFANA_PLUGINS=

# ── Профиль storage ──────────────────────────────────────────────────────────
# 9000 занят нативным портом ClickHouse, поэтому API MinIO выведен на 9010.
MINIO_API_PORT=9010
MINIO_CONSOLE_PORT=9001
MINIO_USER=dojo
MINIO_PASSWORD=dojo_local_dev
MONGO_HOST_PORT=27017
MONGO_USER=dojo
MONGO_PASSWORD=dojo_local_dev

# ── Лимиты памяти контейнеров ────────────────────────────────────────────────
# Хост 16 ГБ, WSL2 отдано 10 ГБ (.wslconfig). Весь стек одновременно не влезает
# и не должен — см. docs/adr/0004 и профили в README.
#
#   core                     ~2.7 ГБ
#   core + ai                ~9.7 ГБ   ← потолок этой машины
#   core + analytics         ~6.4 ГБ
#   core + analytics + storage ~7.5 ГБ
#
# Одновременно ai и analytics на 10 ГБ не живут. Это не недоработка, а
# следствие железа: LLM и аналитика нужны в разные моменты занятия.
MEM_POSTGRES=1g
MEM_REDIS=384m
MEM_API=768m
MEM_OLLAMA=7g
MEM_KAFKA=1300m
MEM_CLICKHOUSE=1500m
MEM_PROMETHEUS=512m
MEM_GRAFANA=384m
MEM_MINIO=512m
MEM_MONGO=640m
