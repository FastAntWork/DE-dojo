# Образ песочницы для kata-заданий.
#
# Здесь выполняется код, написанный человеком, поэтому образ содержит ровно
# то, что нужно для прогона тестов, и ничего больше. Ни компилятора, ни
# сетевых утилит, ни пакетного менеджера с доступом наружу.
#
# Ограничения запуска (сеть, память, процессы, время) задаются не здесь, а
# в docker run: образ описывает, ЧТО исполняется, а не сколько ему позволено.

FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# hypothesis нужен для property-based тестов: они ловят краевые случаи,
# которые автор скрытых тестов не догадался перечислить руками.
# pytest-timeout обязателен, а не удобен. Без него решение, зависшее на
# бесконечном источнике, вешает весь прогон целиком: контейнер убивается по
# внешнему таймауту, отчёт не создаётся, и человек видит «всё зависло» вместо
# «провален тест на ленивость». С ним падает ровно тот тест, который должен.
RUN pip install --no-cache-dir \
        pytest==8.3.4 \
        pytest-timeout==2.3.1 \
        hypothesis==6.122.3 \
    && rm -rf /root/.cache

# Непривилегированный пользователь с заведомо несуществующим домом: коду
# пользователя писать некуда, кроме смонтированного /out.
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin sandbox

USER 10001:10001
WORKDIR /work

# Пустой entrypoint: команду задаёт раннер, чтобы её было видно в логах.
CMD ["pytest", "--version"]
