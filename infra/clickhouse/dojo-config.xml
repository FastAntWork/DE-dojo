<?xml version="1.0"?>
<!--
  Серверные настройки под ноутбук. Монтируется в config.d/ отдельным файлом,
  а не подменой всего каталога: в config.d образа лежит docker_related_config.xml,
  который настраивает listen_host, и затирать его нельзя.

  Размеры фоновых пулов здесь НЕ трогаем. Попытка ужать background_pool_size
  до 4 роняла сервер на старте: ClickHouse требует, чтобы
  background_pool_size * background_merges_mutations_concurrency_ratio было не
  меньше number_of_free_entries_in_pool_to_execute_mutation (по умолчанию 20),
  иначе мутации в принципе неисполнимы. Потоки пула создаются лениво, так что
  экономия всё равно была бы мнимой.
-->
<clickhouse>
    <!-- Явный IPv4. Образ по умолчанию слушает на `::`, а в ядре WSL2 IPv6
         бывает выключен — тогда HTTP-порт 8123 не поднимается вовсе, сервер
         пишет в лог «Address family for hostname not supported», healthcheck
         вечно висит в starting, а зависящие сервисы не дожидаются готовности.
         Сам ClickHouse предлагает это же решение в тексте той ошибки. -->
    <listen_host>0.0.0.0</listen_host>

    <!-- Держимся заметно ниже mem_limit контейнера: превышение лимита cgroup
         убивает процесс без объяснений, а превышение внутреннего лимита даёт
         внятную ошибку запроса, по которой видно, что чинить. -->
    <max_server_memory_usage>1100000000</max_server_memory_usage>

    <mark_cache_size>268435456</mark_cache_size>
    <uncompressed_cache_size>0</uncompressed_cache_size>

    <logger>
        <level>warning</level>
        <console>1</console>
    </logger>
</clickhouse>
