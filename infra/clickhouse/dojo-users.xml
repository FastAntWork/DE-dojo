<?xml version="1.0"?>
<!--
  Ограничения профиля по умолчанию. Это конфигурация ПОЛЬЗОВАТЕЛЕЙ, поэтому
  файл монтируется в users.d/, а не в config.d/ — секция <profiles> в
  серверном конфиге просто не подхватывается.

  Смысл лимитов: одиночный запрос не должен утащить за собой весь сервер.
  На ноутбуке цена ошибки в запросе — это подвисший стек целиком.
-->
<clickhouse>
    <profiles>
        <default>
            <max_memory_usage>800000000</max_memory_usage>
            <max_execution_time>60</max_execution_time>
        </default>
    </profiles>
</clickhouse>
